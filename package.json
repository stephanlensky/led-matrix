{
  "name": "led-matrix",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "fake-device": "pnpm --filter @led-matrix/server fake-device",
    "firmware:build": "pio run -d firmware",
    "firmware:upload": "pio run -d firmware -t upload",
    "firmware:monitor": "pio device monitor -d firmware",
    "firmware:test": "pio test -d firmware -e native",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.15.0"
}
